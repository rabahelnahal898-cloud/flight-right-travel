STRIPE_WEBHOOK_SECRET=
# Add these later to enable email notifications through Resend.
RESEND_API_KEY=
EMAIL_FROM=Flight Right <hello@example.com>
CONTACT_EMAIL=
# Add these later to enable WhatsApp notifications through Meta Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=