PORT=3001
CORS_ORIGIN=http://localhost:4174
# Add this to enable live flight search and booking (order creation).
DUFFEL_API_TOKEN=
DUFFEL_API_URL=https://api.duffel.com
# Add these to enable Stripe Checkout and webhook verification.
